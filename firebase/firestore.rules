rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sudanchamalka@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    // A board's document id is its own auth uid
    function isBoard(id) {
      return request.auth != null && request.auth.uid == id;
    }
    function isApproved(id) {
      return get(/databases/$(database)/documents/boards/$(id)).data.approved == true;
    }

    match /boards/{id} {
      allow read: if isAdmin() || isBoard(id);

      allow create: if isBoard(id)
        && request.resource.data.keys().hasOnly(['name', 'location', 'approved', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0 && request.resource.data.location.size() <= 60
        && request.resource.data.approved == false
        && request.resource.data.createdAt == request.time;

      // Admin can change anything (approve). A board can only update its own usage summary.
      allow update: if isAdmin()
        || (isBoard(id)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastSeen', 'todayDate', 'todayOn', 'todayActive'])
            && request.resource.data.todayDate is string
            && request.resource.data.todayOn is int
            && request.resource.data.todayActive is int
            && request.resource.data.todayOn >= 0 && request.resource.data.todayOn <= 86400
            && request.resource.data.todayActive >= 0
            && request.resource.data.todayActive <= request.resource.data.todayOn);

      allow delete: if isAdmin();

      match /days/{day} {
        allow read: if isAdmin() || isBoard(id);
        allow create, update: if isBoard(id) && isApproved(id)
          && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['onSeconds', 'activeSeconds'])
          && request.resource.data.onSeconds is int
          && request.resource.data.activeSeconds is int
          && request.resource.data.onSeconds <= 86400
          && request.resource.data.activeSeconds >= 0
          && request.resource.data.activeSeconds <= request.resource.data.onSeconds
          && (resource == null
              ? request.resource.data.onSeconds <= 900
              : (request.resource.data.onSeconds >= resource.data.onSeconds
                 && request.resource.data.onSeconds - resource.data.onSeconds <= 900));
        allow delete: if isAdmin();
      }

      match /logs/{log} {
        allow read: if isAdmin();
        allow create: if isBoard(id) && isApproved(id)
          && request.resource.data.keys().hasOnly(['type', 't'])
          && request.resource.data.type == 'start'
          && request.resource.data.t == request.time;
        allow delete: if isAdmin();
      }
    }
  }
}
